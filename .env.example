# Server-only OpenAI credentials. Set OPENAI_MODEL to a model available to your API project.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Required server-side quota configuration. Use a random secret independent of API keys.
AI_DAILY_REQUEST_LIMIT=10
AI_RATE_LIMIT_SECRET=
AI_MIN_REQUEST_INTERVAL_SECONDS=3

# Supabase project settings (the publishable key is safe for browser use).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only elevated key. Prefer the newer secret key; service role is supported for older projects.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
