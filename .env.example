# Server-only OpenAI credentials. Set OPENAI_MODEL to a model available to your API project.
OPENAI_API_KEY=
OPENAI_MODEL=

# Required server-side quota configuration.
AI_DAILY_REQUEST_LIMIT=10
AI_RATE_LIMIT_SECRET=

# Required for persistent production quotas and future authenticated conversation storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
